---
import Icon from '@/components/ui/Icon.astro';
import { articles } from '@/config/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  return articles.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BaseLayout>
  <article class="shell max-w-3xl pt-14 pb-24 sm:pt-20">
    <a href="/journal/" class="inline-flex items-center gap-2 text-sm text-muted hover:text-body">
      ← All articles
    </a>

    <p class="mt-8 text-xs font-medium tracking-wider uppercase text-muted">
      {post.category} · {post.readTime} · {post.date}
    </p>
    <h1 class="mt-3 text-section sm:text-display">{post.title}</h1>
    <p class="mt-5 text-lead text-muted">{post.summary}</p>

    <div class="mt-10 space-y-6 border-t border-line pt-8 text-body leading-relaxed">
      {post.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="mt-14 border-t border-line pt-8">
      <a class="btn btn-ghost" href="/journal/">
        Back to journal
        <Icon name="arrow-right" class="icon-nudge size-4" />
      </a>
    </div>
  </article>
</BaseLayout>
