---
import Icon from '@/components/ui/Icon.astro';
import { articles, articlesMeta } from '@/config/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="shell pt-14 pb-24 sm:pt-20">
    <p class="text-xs font-medium tracking-wider uppercase text-muted">{articlesMeta.eyebrow}</p>
    <h1 class="mt-3 max-w-[20ch] text-display">
      {articlesMeta.title} <span class="serif">{articlesMeta.highlight}</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lead text-body">{articlesMeta.text}</p>

    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {articles.map((post) => (
        <li class="reveal flex flex-col justify-between rounded-card border border-line bg-surface p-7 transition hover:border-body/30">
          <div>
            <p class="text-xs font-medium text-muted">
              {post.category} · {post.readTime} · {post.date}
            </p>
            <h2 class="mt-4 text-title">
              <a href={`/journal/${post.slug}/`} class="hover:underline">
                {post.title}
              </a>
            </h2>
            <p class="mt-3 text-sm text-muted">{post.summary}</p>
          </div>

          <div class="mt-6 border-t border-line pt-4">
            <a href={`/journal/${post.slug}/`} class="inline-flex items-center gap-2 text-sm font-medium text-body hover:underline">
              Read article
              <Icon name="arrow-right" class="icon-nudge size-4" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
