---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/maria.webp';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
import { siteConfig } from '@/config/site';
---

<section class="shell pt-14 pb-16 sm:pt-20 sm:pb-24 lg:pt-24" aria-labelledby="hero-title">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-14">
    <div>
      {siteConfig.availability.enabled && (
        <p class="rise inline-flex items-center gap-3 rounded-full border border-line bg-surface py-1.5 pr-4 pl-1.5 text-sm text-body shadow-[0_1px_2px_rgb(18_18_17/0.04)]">
          <Image
            src={portrait}
            alt=""
            width={56}
            height={56}
            loading="eager"
            class="size-7 rounded-full object-cover object-top"
          />
          <span class="availability-dot" aria-hidden="true" />
          {siteConfig.availability.label}
        </p>
      )}

      <h1 id="hero-title" class="rise mt-8 max-w-[16ch] text-display" style="--rise-step: 1">
        {hero.greeting} {hero.title} <span class="serif">{hero.highlight}</span>
      </h1>

      <p class="rise mt-8 max-w-xl text-lead text-body" style="--rise-step: 2">
        {hero.text}
      </p>

      <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 2">
        <a class="btn btn-primary" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>

      <dl
        class="rise mt-10 grid grid-cols-3 gap-6 border-t border-line pt-6 sm:gap-10"
        style="--rise-step: 3"
      >
        {hero.facts.map((fact) => (
          <div class="flex flex-col-reverse gap-1">
            <dt class="max-w-[13ch] text-sm leading-snug text-muted">{fact.label}</dt>
            <dd class="text-section">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Portrait Card -->
    <aside class="rise mx-auto w-full max-w-[340px] rounded-card border border-line bg-surface p-3 shadow-sm" style="--rise-step: 2">
      <div class="relative overflow-hidden rounded-[calc(var(--radius-card,16px)-6px)] bg-line">
        <Image
          src={portrait}
          alt={siteConfig.author.name}
          width={680}
          height={820}
          loading="eager"
          class="aspect-[4/5] w-full object-cover object-top"
        />
        <div class="absolute top-3 right-3 flex flex-col gap-2">
          {siteConfig.socials.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
              title={item.label}
              class="grid size-9 place-items-center rounded-full border border-line bg-surface/90 text-xs font-medium text-body backdrop-blur transition hover:bg-accent hover:text-on-accent"
            >
              {item.label.slice(0, 2)}
            </a>
          ))}
        </div>
      </div>
      {siteConfig.availability.enabled && (
        <div class="flex items-center gap-2.5 px-2 pt-3 pb-1 text-xs text-muted">
          <span class="availability-dot shrink-0" aria-hidden="true" />
          <span>{siteConfig.availability.label}</span>
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .availability-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22a55b;
  }

  @media (prefers-reduced-motion: no-preference) {
    .availability-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
