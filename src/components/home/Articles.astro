---
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import { articles, articlesMeta } from '@/config/articles';

const latest = articles.slice(0, 3);
---

<section class="shell mt-28 sm:mt-36" aria-labelledby="articles-title">
  <SectionHead
    id="articles-title"
    eyebrow={articlesMeta.eyebrow}
    title={`${articlesMeta.title} ${articlesMeta.highlight}`}
    text={articlesMeta.text}
  >
    <a class="btn btn-ghost" href="/journal/">
      All articles
      <Icon name="arrow-right" class="icon-nudge size-4" />
    </a>
  </SectionHead>

  <ul class="mt-12 grid gap-6 md:grid-cols-3">
    {latest.map((post) => (
      <li class="reveal flex flex-col justify-between rounded-card border border-line bg-surface p-7 transition hover:border-body/30">
        <div>
          <p class="text-xs font-medium text-muted">
            {post.category} · {post.readTime} · {post.date}
          </p>
          <h3 class="mt-4 text-title">
            <a href={`/journal/${post.slug}/`} class="hover:underline">
              {post.title}
            </a>
          </h3>
          <p class="mt-3 text-sm text-muted">{post.summary}</p>
        </div>

        <div class="mt-6 pt-4 border-t border-line">
          <a href={`/journal/${post.slug}/`} class="inline-flex items-center gap-2 text-sm font-medium text-body hover:underline">
            Read article
            <Icon name="arrow-right" class="icon-nudge size-4" />
          </a>
        </div>
      </li>
    ))}
  </ul>
</section>
